# Postgres (Neon/Supabase: use a URL com ?sslmode=require)
DATABASE_URL=postgres://usuario:senha@localhost:5432/lista_presentes

# Token do admin: gere um valor longo e aleatório, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=troque-por-um-valor-longo-e-aleatorio

# Origem(ns) do front-end liberadas no CORS, separadas por vírgula
FRONTEND_ORIGIN=http://localhost:5500,https://seu-site.vercel.app

# Chave Pix usada apenas no seed (não fica no repositório)
PIX_KEY=

PORT=3000
